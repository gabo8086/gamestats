        "timestamp": "2026-10-05T16:00:00.000Z",
        "gameId": "racing",
        "matchId": "m-invalid-001",
        "playerId": null,
        "type": "MATCH_STARTED",
        "action": null,
        "data": { "laps": 3, "track": "Circuito Volcan" }
      }
    },
